{
  "name": "react-avatar-kit",
  "version": "1.1.0",
  "description": "Deterministic, zero-dependency avatar kit for React 18 and 19. One seed in, one memorable avatar out.",
  "keywords": [
    "react",
    "avatar",
    "react-avatar",
    "avatar-generator",
    "deterministic",
    "seed",
    "svg",
    "typescript",
    "react-server-components",
    "zero-dependency"
  ],
  "author": "Keaton Hoskins",
  "license": "MIT",
  "homepage": "https://kryptobaseddev.github.io/react-avatar-kit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kryptobaseddev/react-avatar-kit.git"
  },
  "bugs": {
    "url": "https://github.com/kryptobaseddev/react-avatar-kit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "docs/api.md",
    "docs/integrations.md",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "vite --config site/vite.config.ts",
    "build:site": "vite build --config site/vite.config.ts && npm run build:docs && rm -rf site/dist/docs && cp -R docs-site/dist site/dist/docs",
    "preview:site": "vite preview --config site/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config e2e/playwright.config.ts --project=e2e",
    "test:visual": "playwright test --config e2e/playwright.config.ts --project=visual",
    "test:visual:update": "playwright test --config e2e/playwright.config.ts --project=visual --update-snapshots",
    "check:api": "node scripts/check-api.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:ssr": "node scripts/check-ssr.mjs",
    "check:consumer": "node scripts/check-consumer.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "check:all": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:api && npm run check:package && npm run check:ssr && npm run check:compat && npm run build:docs && npm run check:docs && npm run check:consumer && npm run test:e2e && npm run test:docs && npm run test:visual",
    "prepublishOnly": "npm run build && npm run check:package",
    "check:compat": "npm run build && node scripts/check-compat.mjs",
    "build:docs": "node scripts/build-docs-index.mjs && vite build --config docs-site/vite.config.ts",
    "check:docs": "node scripts/check-docs.mjs",
    "test:docs": "playwright test --config e2e/playwright.config.ts --project=docs",
    "check:examples": "npm run build && node scripts/check-examples.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
